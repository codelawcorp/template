#!/bin/sh
# Stub of the shared commit hook (magzim21/utilities, README "Shared commit hooks"; written by git-hooks-install, the
# same bytes in every repository): it runs ~/scripts/git-hooks-pre-commit, which checks the branch name, runs this
# repository's own checks in .githooks/pre-commit.local, then scans the staged changes for secrets with gitleaks.
# This repository's own checks go into .githooks/pre-commit.local, never here. Never git commit --no-verify.
h=${GIT_HOOKS_PRE_COMMIT:-$HOME/scripts/git-hooks-pre-commit}
[ -x "$h" ] && exec "$h" "$@"
echo "pre-commit: COMMIT REFUSED: $h is missing, so no secret scan can run. Release the shared hooks:" \
     "cd ~/Developer/github/magzim21/utilities && ./utilities-release" >&2
exit 1
