#!/bin/sh
# Stub of the shared commit message hook (magzim21/utilities, README "Shared commit hooks"; written by
# git-hooks-install, the same bytes in every repository): it runs ~/scripts/git-hooks-commit-msg, which runs this
# repository's own .githooks/commit-msg.local when there is one, then the commitlint rules of its commitlint config:
# Conventional Commits, lines of at most 100 characters, no Co-Authored-By. Never git commit --no-verify.
h=${GIT_HOOKS_COMMIT_MSG:-$HOME/scripts/git-hooks-commit-msg}
[ -x "$h" ] && exec "$h" "$@"
echo "commit-msg: COMMIT REFUSED: $h is missing, so the message cannot be checked. Release the shared hooks:" \
     "cd ~/Developer/github/magzim21/utilities && ./utilities-release" >&2
exit 1
